---
// Authored icon set from landing/src/components/ui/Icon.tsx: 24px grid,
// 1.5px stroke, square caps, currentColor. Only the icons the docs use.
const paths = {
  "arrow-right": "M4 12h15M13 6l6 6-6 6",
  "arrow-up-right": "M7 17 17 7M8 7h9v9",
  lock: "M5 10.5h14v10H5zM8 10.5v-3a4 4 0 0 1 8 0v3",
} as const;

interface Props {
  name: keyof typeof paths;
  size?: number;
}

const { name, size = 20 } = Astro.props;
---

<svg
  data-icon={name}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
